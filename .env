# ── Firebase Realtime Database ────────────────────────────────────────────────
# Chi can URL cua database, khong can file JSON service account
FIREBASE_DATABASE_URL=https://gpbl-group2-default-rtdb.asia-southeast1.firebasedatabase.app
FIREBASE_SENSOR_PATH=/devices/esp32-node-01/telemetry
FIREBASE_AUTH_SECRET=

# ── Gmail (dung App Password, khong phai mat khau Gmail thuong) ──────────────
# Huong dan: Google Account > Security > 2-Step Verification > App Passwords
GMAIL_SENDER=
GMAIL_APP_PASSWORD=
GMAIL_RECIPIENT=
