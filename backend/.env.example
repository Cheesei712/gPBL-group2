# OPENROUTER CONFIGURATION (Get key from https://openrouter.ai/keys)
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_MODEL=google/gemini-2.5-flash

# DIRECT GEMINI CONFIGURATION (Get key from Google AI Studio)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.7-flash

# DEVICE AUTHENTICATION KEY
DEVICE_API_KEY=replace-with-a-long-random-device-key

# ANALYSIS MODE: "openrouter", "gemini", or "rules"
ANALYSIS_MODE=openrouter
LOG_LEVEL=INFO
