# Tao API key tai Google AI Studio.
GEMINI_API_KEY=replace-with-your-gemini-api-key

# Khoa rieng de ESP32 goi backend. Khong dung Gemini API key tren ESP32.
DEVICE_API_KEY=replace-with-a-long-random-device-key

GEMINI_MODEL=gemini-3.5-flash-lite
# Dung rules de test HTTP/phần cứng không cần Gemini; đổi thành gemini khi tích hợp LLM.
ANALYSIS_MODE=rules
LOG_LEVEL=INFO
